{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static marketing site for Black Rim Solutions LLC. No Worker code: every request is served
  // straight from public/ (free, no Worker invocations).
  "name": "blackrimsolutions",
  "compatibility_date": "2026-11-01",

  // TEMPORARY: the domain's DNS is still at Namecheap (pointing at the old Netlify site), so the
  // site is served on workers.dev for now. Once blackrimsolutions.com is added to Cloudflare,
  // set workers_dev to false and uncomment routes. www → apex is then a Redirect Rule in the
  // dashboard (Rules → Redirect Rules → "Redirect from WWW to root").
  "workers_dev": true,
  // "routes": [
  //   { "pattern": "blackrimsolutions.com", "custom_domain": true },
  //   { "pattern": "www.blackrimsolutions.com", "custom_domain": true }
  // ],

  "assets": {
    "directory": "public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
